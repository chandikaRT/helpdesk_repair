# Normalize line endings to LF in the repository
* text=auto eol=lf

# Python and XML always LF
*.py text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.txt text eol=lf

# Binary — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.docx binary
*.pdf binary
*.ico binary
